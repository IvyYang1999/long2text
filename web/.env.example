# Copy to .env.local for local development. Production values live in Vercel → Settings → Environment Variables.

# Tencent Cloud OCR (GeneralBasicOCR) — https://console.cloud.tencent.com/cam/capi
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# Auth.js (next-auth v5) — `npx auth secret` generates one
AUTH_SECRET=
# Google OAuth client — https://console.cloud.google.com/apis/credentials?project=long2text
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe — use sk_live_/whsec_ from the LIVE dashboard for production, sk_test_ for local
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Postgres (Vercel Postgres / Neon) — pooled URL used by @vercel/postgres
POSTGRES_URL=

# AI proofreading of low-confidence OCR lines (optional — the toggle hides itself when unset)
# SiliconFlow key: https://cloud.siliconflow.cn/account/ak ; model defaults to Qwen/Qwen3-8B
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=
